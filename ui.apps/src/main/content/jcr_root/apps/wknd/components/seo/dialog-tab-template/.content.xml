<?xml version="1.0" encoding="UTF-8"?>
<!--
    Template/Policy variant of the SEO tab.
    This keeps manual defaults only (no AI generation controls),
    because template policies are authored before page content exists.

    Stored properties (under ./seo):
      Organization-specific (./seo/type = "Organization"):
      ./seo/orgLegalName, ./seo/orgLogo, ./seo/orgTelephone, ./seo/orgEmail,
      ./seo/orgSameAs, ./seo/orgFoundingDate,
      ./seo/orgStreetAddress, ./seo/orgAddressLocality, ./seo/orgAddressRegion,
      ./seo/orgPostalCode, ./seo/orgAddressCountry
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="granite/ui/components/coral/foundation/container"
    granite:class="wknd-seo-dialog wknd-seo-dialog-template"
    margin="{Boolean}true">
    <items jcr:primaryType="nt:unstructured">
        <columns
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
            margin="{Boolean}true">
            <items jcr:primaryType="nt:unstructured">
                <column
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                    <items jcr:primaryType="nt:unstructured">
                        <enabled
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                            name="./seo/enabled"
                            text="Emit Schema.org / JSON-LD on pages using this template"
                            value="{Boolean}true"
                            uncheckedValue="{Boolean}false"
                            checked="{Boolean}true"/>

                        <mode
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldLabel="Default Strategy"
                            fieldDescription="Default page-level behavior vs template defaults."
                            name="./seo/mode">
                            <items jcr:primaryType="nt:unstructured">
                                <merge
                                    jcr:primaryType="nt:unstructured"
                                    text="Merge with template defaults (recommended)"
                                    value="merge"
                                    selected="{Boolean}true"/>
                                <override
                                    jcr:primaryType="nt:unstructured"
                                    text="Override template defaults"
                                    value="override"/>
                                <disable
                                    jcr:primaryType="nt:unstructured"
                                    text="Disable (no JSON-LD)"
                                    value="disable"/>
                            </items>
                        </mode>

                        <type
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldLabel="Default Primary @type"
                            name="./seo/type"
                            emptyText="Select a type">
                            <items jcr:primaryType="nt:unstructured">
                                <webpage    jcr:primaryType="nt:unstructured" text="WebPage"        value="WebPage" selected="{Boolean}true"/>
                                <org        jcr:primaryType="nt:unstructured" text="Organization"   value="Organization"/>
                                <article    jcr:primaryType="nt:unstructured" text="Article"        value="Article"/>
                                <newsArt    jcr:primaryType="nt:unstructured" text="NewsArticle"    value="NewsArticle"/>
                                <blog       jcr:primaryType="nt:unstructured" text="BlogPosting"    value="BlogPosting"/>
                                <product    jcr:primaryType="nt:unstructured" text="Product"        value="Product"/>
                                <event      jcr:primaryType="nt:unstructured" text="Event"          value="Event"/>
                                <faq        jcr:primaryType="nt:unstructured" text="FAQPage"        value="FAQPage"/>
                                <howto      jcr:primaryType="nt:unstructured" text="HowTo"          value="HowTo"/>
                                <person     jcr:primaryType="nt:unstructured" text="Person"         value="Person"/>
                                <place      jcr:primaryType="nt:unstructured" text="Place"          value="Place"/>
                                <recipe     jcr:primaryType="nt:unstructured" text="Recipe"         value="Recipe"/>
                                <video      jcr:primaryType="nt:unstructured" text="VideoObject"    value="VideoObject"/>
                                <breadcrumb jcr:primaryType="nt:unstructured" text="BreadcrumbList" value="BreadcrumbList"/>
                            </items>
                        </type>

                        <!-- Article-like defaults (Article / NewsArticle / BlogPosting only) -->
                        <articleFields
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/well"
                            granite:class="wknd-seo-article-fields"
                            data-show-for-types="Article,NewsArticle,BlogPosting">
                            <items jcr:primaryType="nt:unstructured">
                                <articleHeading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/heading"
                                    level="{Long}4"
                                    text="Article-specific default properties"/>

                                <articleSection
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Article Section"
                                    name="./seo/articleSection"/>

                                <wordCount
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                    fieldLabel="Default Word Count"
                                    name="./seo/wordCount"
                                    min="{Long}0"
                                    step="{Long}1"/>

                                <publisherName
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Publisher Name"
                                    name="./seo/publisherName"/>

                                <publisherLogo
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Default Publisher Logo"
                                    name="./seo/publisherLogo"
                                    rootPath="/content/dam"/>

                                <authorType
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                    fieldLabel="Default Author Type"
                                    name="./seo/authorType">
                                    <items jcr:primaryType="nt:unstructured">
                                        <person
                                            jcr:primaryType="nt:unstructured"
                                            text="Person"
                                            value="Person"
                                            selected="{Boolean}true"/>
                                        <organization
                                            jcr:primaryType="nt:unstructured"
                                            text="Organization"
                                            value="Organization"/>
                                    </items>
                                </authorType>

                                <authorUrl
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Author URL"
                                    name="./seo/authorUrl"/>
                            </items>
                        </articleFields>

                        <!-- Organization-specific defaults (Organization only) -->
                        <organizationFields
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/well"
                            granite:class="wknd-seo-org-fields"
                            data-show-for-types="Organization">
                            <items jcr:primaryType="nt:unstructured">
                                <orgHeading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/heading"
                                    level="{Long}4"
                                    text="Organization-specific default properties"/>

                                <orgLegalName
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Legal Name"
                                    name="./seo/orgLegalName"/>

                                <orgLogo
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Default Logo"
                                    name="./seo/orgLogo"
                                    rootPath="/content/dam"/>

                                <orgTelephone
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Telephone"
                                    name="./seo/orgTelephone"/>

                                <orgEmail
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Email"
                                    name="./seo/orgEmail"/>

                                <orgSameAs
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                    fieldLabel="Default sameAs URLs">
                                    <field
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        name="./seo/orgSameAs"/>
                                </orgSameAs>

                                <orgFoundingDate
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                    fieldLabel="Default Founding Date"
                                    name="./seo/orgFoundingDate"
                                    type="date"
                                    displayedFormat="YYYY-MM-DD"
                                    valueFormat="YYYY-MM-DD"/>

                                <orgAddressHeading
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/heading"
                                    level="{Long}5"
                                    text="Default Postal Address"/>

                                <orgStreetAddress
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Street Address"
                                    name="./seo/orgStreetAddress"/>

                                <orgAddressLocality
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default City"
                                    name="./seo/orgAddressLocality"/>

                                <orgAddressRegion
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default State / Region"
                                    name="./seo/orgAddressRegion"/>

                                <orgPostalCode
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Postal Code"
                                    name="./seo/orgPostalCode"/>

                                <orgAddressCountry
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Default Country Code"
                                    fieldDescription="ISO 3166-1 alpha-2, e.g. US, GB, DE."
                                    name="./seo/orgAddressCountry"/>
                            </items>
                        </organizationFields>

                        <headline
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Default Headline"
                            name="./seo/headline"/>

                        <description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="Default Description"
                            name="./seo/description"
                            rows="{Long}3"/>

                        <author
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Default Author"
                            name="./seo/author"/>

                        <datePublished
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                            fieldLabel="Default Date Published"
                            name="./seo/datePublished"
                            type="datetime"
                            displayedFormat="YYYY-MM-DD HH:mm"
                            valueFormat="YYYY-MM-DDTHH:mmZ"/>

                        <dateModified
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                            fieldLabel="Default Date Modified"
                            name="./seo/dateModified"
                            type="datetime"
                            displayedFormat="YYYY-MM-DD HH:mm"
                            valueFormat="YYYY-MM-DDTHH:mmZ"/>

                        <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="Default Primary Image"
                            name="./seo/image"
                            rootPath="/content/dam"/>

                        <keywords
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            fieldLabel="Default Keywords">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                name="./seo/keywords"/>
                        </keywords>

                        <jsonLd
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            granite:class="wknd-seo-jsonld"
                            fieldLabel="Default JSON-LD (optional)"
                            fieldDescription="Optional template-level raw JSON-LD fallback. Page-level JSON-LD can override this."
                            name="./seo/jsonLd"
                            rows="{Long}10"
                            resizable="vertical"/>
                    </items>
                </column>
            </items>
        </columns>
    </items>
</jcr:root>
